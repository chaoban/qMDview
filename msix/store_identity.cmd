@rem ==========================================================================
@rem  Microsoft Store package identity for qMDView (read by build_msix.bat)
@rem
@rem  Where: Partner Center / Apps and games / qMDView / Product management /
@rem         Product identity
@rem  Copy the three values EXACTLY (copy and paste, keep case and spaces).
@rem  A mismatch makes the package upload fail.
@rem
@rem    Package/Identity/Name                    = MSIX_IDENTITY_NAME
@rem    Package/Identity/Publisher (CN=...)      = MSIX_PUBLISHER
@rem    Package/Properties/PublisherDisplayName  = MSIX_PUBLISHER_DISPLAY_NAME
@rem
@rem  Keep the quotes exactly as below:  set "NAME=value"
@rem ==========================================================================
set "MSIX_IDENTITY_NAME=SAISAI.Dev.qMDView"
set "MSIX_PUBLISHER=CN=8EE2A838-6C91-4290-8711-F41153FB93C1"
set "MSIX_PUBLISHER_DISPLAY_NAME=SAISAI.Dev"
