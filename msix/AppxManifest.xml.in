<?xml version="1.0" encoding="utf-8"?>
<!--
  qMDView MSIX manifest template (used by build_msix.bat).
  @...@ tokens are filled in from msix\store_identity.cmd and CMakeLists.txt.
  Keep this file ASCII-only.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap2 uap3 desktop rescap">

  <!-- Name / Publisher must be copied exactly from Partner Center > Product identity.
       The 4th version number must stay 0 (reserved by the Store). -->
  <Identity
    Name="@IDENTITY_NAME@"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <!-- Must match the app name reserved in Partner Center -->
    <DisplayName>qMDView</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Description>Markdown viewer and editor</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- Qt 6 supports Windows 10 1809 (build 17763) and later, x64 only -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- UI languages (since 1.1.0): Traditional Chinese and English, see src/uilanguage.cpp.
       Partner Center offers a Store listing for each language declared here.
       Keep this list in sync with UiLanguage::available(). -->
  <Resources>
    <Resource Language="zh-TW" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="qMDView" Executable="qMDView.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="qMDView"
        Description="Markdown viewer and editor"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- .md / .markdown: qMDView appears in "Open with"; the file path is passed as argv[1] -->
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="markdown">
            <uap:DisplayName>Markdown Document</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.md</uap:FileType>
              <uap:FileType>.markdown</uap:FileType>
            </uap:SupportedFileTypes>
            <uap2:SupportedVerbs>
              <uap3:Verb Id="open" Parameters="&quot;%1&quot;">open</uap3:Verb>
            </uap2:SupportedVerbs>
          </uap3:FileTypeAssociation>
        </uap3:Extension>

        <!-- Lets users start the app by typing "qmdview" in Run / a terminal -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="qMDView.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="qmdview.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <!-- runFullTrust: required for every Win32 (non-UWP) desktop app.
       It is a restricted capability: explain it under Submission options in Partner Center. -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
