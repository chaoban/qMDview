// Windows resource template (processed by CMake configure_file).
// Provides the exe icon and the version info shown in
// File Explorer -> Properties -> Details.
#include <winver.h>

IDI_ICON1 ICON "@APP_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "@APP_PUBLISHER@"
            VALUE "FileDescription",  "qMDView - Markdown Viewer"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "qMDView"
            VALUE "LegalCopyright",   "@APP_COPYRIGHT@"
            VALUE "OriginalFilename", "qMDView.exe"
            VALUE "ProductName",      "qMDView"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
